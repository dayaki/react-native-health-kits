{
  "$schema": "https://unpkg.com/release-it/schema/release-it.json",
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "v${version}",
    "requireBranch": "main",
    "requireCleanWorkingDir": true,
    "requireUpstream": true
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "releaseNotes": "bash scripts/release-notes.sh ${version}"
  },
  "npm": {
    "publish": true
  },
  "hooks": {
    "before:init": ["yarn typecheck"],
    "after:bump": [
      "bash scripts/changelog-stamp.sh ${version}",
      "yarn prepare"
    ]
  }
}
